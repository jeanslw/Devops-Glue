{
    "require": {
        "php": ">=8.0",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.0",
        "guzzlehttp/guzzle": "^7.12",
        "vlucas/phpdotenv": "^5.6",
        "psr/simple-cache": "^3.0",
        "symfony/translation": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Config\\": "config/" 
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
