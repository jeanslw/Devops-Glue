# ============================================================
# Docker Compose shared variables（Docker Compose 共享变量，集中部署 CI + CD + MySQL 的唯一来源）
# ============================================================
# This file is consumed in three places（本文件同时被三处消费）:
#   1. Interpolation — DB_PASS / DB_NAME of the mysql service (read by Compose at parse time)
#      （插值 —— mysql 服务的 DB_PASS / DB_NAME，compose 解析时读取）
#   2. CI env_file — injected into the devops-glue container, overriding same-name
#      DB/Harbor keys in config/app.env
#      （CI 的 env_file —— 注入 devops-glue 容器，覆盖 config/app.env 里同名 DB/Harbor 键）
#   3. CD env_file — injected into the devops-cd container, providing DB / Harbor / SECRET_KEY / CI_API_TOKEN
#      （CD 的 env_file —— 注入 devops-cd 容器，提供 DB / Harbor / SECRET_KEY / CI_API_TOKEN）
#
# Trusted reverse-proxy hops, shared by the CI container and the jointly deployed CD container.
# （可信反向代理跳数，CI 容器与联合部署的 CD 容器共用此值。）
#   - One nginx/gateway proxy layer in front of the containers (common topology): keep 1
#     （容器前有一层 nginx/网关反代（常见拓扑）：保持 1）
#   - Port 8080 exposed directly to end users with no outer proxy: set 0
#     （8080 端口直接暴露给终端、无任何外层代理：改为 0）
#   - Add one hop per extra proxy layer.（多层代理按层数递增。）
TRUSTED_PROXY_HOPS=1

# Container timezone, shared by CI / MySQL / jointly deployed CD. IANA name, e.g. Asia/Shanghai, UTC.
# （容器时区（CI / MySQL / 联合部署的 CD 共用）。IANA 名称，如 Asia/Shanghai、UTC。）
#TZ=Asia/Shanghai

# ---------------- Database (mysql container，数据库，CI + CD 共用连 mysql 容器) ----------------
# Used only for first-time initialization of the mysql container
# (MYSQL_USER / MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD).
# （仅用于 docker compose 首启初始化 mysql 容器（MYSQL_USER/MYSQL_PASSWORD/MYSQL_ROOT_PASSWORD）。）
# Required and must be changed to your own strong passwords (recommend: openssl rand -base64 24):
#    - Empty values abort docker compose startup;（留空时 docker compose 拒绝启动；）
#    - Effective only on first init of the mysql-data volume; existing volumes need manual account creation
#      (see the comments in docker-compose.yml).
#      （仅在 mysql-data 数据卷首次初始化时生效，存量卷需手工建号（见 docker-compose.yml 注释）。）
# CI-only configuration (Jenkins/GitLab/GitHub/Gitee/OIDC/LDAP/APP_ENV etc.) still lives in config/app.env;
# bare-metal deployments also only change config/app.env. This file takes effect in Docker mode only.
# （CI 应用专属配置（Jenkins/GitLab/GitHub/Gitee/OIDC/LDAP/APP_ENV 等）仍在 config/app.env，
#   裸机部署也只改 config/app.env。本文件只在 Docker 下生效。）
# Exception: the CD-pairing OIDC keys (OIDC_ISSUER / CD_OIDC_SECRET / CD_OIDC_REDIRECT_URI) are shared
# by CI and CD in joint deployment and therefore live in THIS file (see the OIDC section below).
# （例外：CD 配对的 OIDC 三项（OIDC_ISSUER / CD_OIDC_SECRET / CD_OIDC_REDIRECT_URI）在联合部署中
#   CI/CD 共用，故写在本文件（见下方 OIDC 段）。）
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=devops
DB_PASS=
DB_ROOT_PASS=

# ---------------- Harbor (shared by CI + CD，Harbor，CI + CD 共用) ----------------
# Always use a scheme-ful HARBOR_BASE_URL: CI uses it directly; CD strips the scheme for image references.
# （统一用带 scheme 的 HARBOR_BASE_URL：CI 直接用，CD 内部剥掉 scheme 用于镜像引用。）
HARBOR_BASE_URL=http://YOUR_HARBOR_URL
HARBOR_USER=YOUR_HARBOR_USER
HARBOR_PASSWORD=YOUR_HARBOR_PASS

# ---------------- CI tag cron intervals（CI 的 tag 清理/回填定时任务间隔，秒） ----------------
# The CI container's supervisord sleep-loops run cleanup-pipeline-tags / backfill-pipeline-tags
# every N seconds; these two vars override the loop intervals. Read from the container environment.
# （CI 容器的 supervisord sleep-loop 每隔 N 秒跑一次 cleanup-pipeline-tags / backfill-pipeline-tags；
#   这两个变量覆盖循环间隔，从容器环境读取。）
# Defaults: cleanup 3600s (1h), backfill 1800s (30min). Uncomment to override.
# （默认：清理 3600 秒（1 小时）、回填 1800 秒（30 分钟）。取消注释覆盖。）
#TAG_CLEANUP_INTERVAL=3600
#TAG_BACKFILL_INTERVAL=1800

# ---------------- CI database backup（CI 数据库定时备份：CI 表与 CD 表分离） ----------------
# The CI container's supervisord runs a backup loop (cli/backup-db.php) that produces TWO
# independent files each run: db_backup_ci_*.sql (CI app tables) + db_backup_cd_*.sql (CD cd_* tables).
# （CI 容器的 supervisord 跑备份循环（cli/backup-db.php），每次产出两份独立文件：
#   db_backup_ci_*.sql（CI 应用表）+ db_backup_cd_*.sql（CD 的 cd_* 表），各自独立恢复、互不牵连。）
# Disabled by default: set DB_BACKUP_ENABLED=1 to enable. Backups land in BACKUP_DIR
# (/data/backups in the image), each prefix rotated to the newest 10 files.
# （默认关闭，设为 1 启用。备份落在 BACKUP_DIR（镜像内 /data/backups），各自前缀滚动保留最新 10 份。）
# Interval in seconds (default 86400 = daily); DB_BACKUP_INTERVAL overrides it.
# （间隔秒数，默认 86400（每天一次）；DB_BACKUP_INTERVAL 覆盖。）
# cache / ci_platform_versions are always excluded (session tokens are volatile credentials;
# Git API caches are re-fetched after restore).
# （cache / ci_platform_versions 始终排除（会话 token 是易失凭证；Git API 缓存恢复后自动重拉）。）
#DB_BACKUP_ENABLED=0
#DB_BACKUP_INTERVAL=86400

# ---------------- CI application logs（CI 应用日志） ----------------
# The CI app (Logger) writes app-YYYY-MM-DD.log to LOG_PATH and self-cleans files older than
# LOG_RETAIN_DAYS (default 30; 0 = keep forever). Works in Docker and bare-metal alike — no logrotate needed.
# （CI 应用（Logger）写 app-YYYY-MM-DD.log 到 LOG_PATH，并自动清理超过 LOG_RETAIN_DAYS 天的旧文件
#   （默认 30，0=永久保留）。裸机/Docker 通用，无需 logrotate。）
#LOG_RETAIN_DAYS=30

# ---------------- OIDC single sign-on（OIDC 单点登录：CD 经 Glue 登录，联合部署必填） ----------------
# CD 已移除本地密码登录，登录唯一入口是 Glue OIDC。启用 devops-cd（联合部署）时以下三项必填，
# 缺任一项：CD 启动被预检中止，登录页列出缺项。
# （CD removed local password login; Glue OIDC is the only sign-in path. When the devops-cd service
#   is enabled (joint deployment), these three are required — missing one aborts CD startup and the
#   login page lists it.）
# 三值必须与 config/app.env 同名项逐字符一致。Docker 下 Glue 容器也会以本文件覆盖 config/app.env
# 的同名键，故联合部署以本文件为权威来源，config/app.env 仅裸机生效。
# （All three must match config/app.env character-for-character. In Docker the Glue container also lets
#   this file override those same keys, so in joint deployment this file is canonical; config/app.env
#   applies to bare-metal only.）
# OIDC_ISSUER — Glue 对外地址（OIDC provider issuer），须与其 discovery 的 issuer 完全一致（CD 据此
#   发现端点并校验 id_token）。同一台机器（Docker Desktop / WSL，浏览器与容器同机）填
#   http://localhost:8080，并确保 docker-compose 的 devops-cd 已加 extra_hosts: ["localhost:host-gateway"]
#   （把容器内 localhost 回落到宿主机网关，否则会连到容器自己）；纯容器间互访也可填 http://devops-glue；
#   经外部域名/反向代理访问时用外部可达 URL，否则 authorize 页打不开、id_token iss 校验失败。
# （Glue's public base URL; must equal the discovery issuer exactly. On one host (Docker Desktop / WSL,
#   browser + container on the same machine) use http://localhost:8080 and ensure devops-cd has
#   extra_hosts: ["localhost:host-gateway"]; container-to-container may also use http://devops-glue;
#   external domain / reverse-proxy access must use an externally reachable URL.）
OIDC_ISSUER=
# CD_OIDC_SECRET — CD 的 OIDC 客户端密钥，与 Glue oauth_clients['cd']['secret'] 一致（任意强随机串）。
#   生成：php -r "echo bin2hex(random_bytes(32));"；同一值同步到两端，不要写进 git。
# （CD's OIDC client secret; must equal Glue oauth_clients['cd']['secret']. Generate:
#   php -r "echo bin2hex(random_bytes(32));". Sync the same value to both sides; never commit it.）
CD_OIDC_SECRET=
# CD_OIDC_REDIRECT_URI — CD 回调地址（浏览器授权后跳回 CD），与 Glue 登记值逐字符一致（含
#   scheme/host/port/path）。必须写成浏览器实际访问 CD 的地址，不能是容器名/localhost。
# （CD's callback URL (where the browser returns after authorization); must equal the value registered
#   in Glue character-for-character, including scheme/host/port/path. Use the URL the browser actually
#   reaches CD at, not a container name / localhost.）
CD_OIDC_REDIRECT_URI=

# ---------------- CD only（CD 专用） ----------------
# CD field-encryption key (generate with: openssl rand -base64 32, 32+ random chars).
# （CD 的字段加密密钥（openssl rand -base64 32 生成 32+ 字符随机串）。）
# Purpose: encrypts SSH passwords/private keys saved in CD; if leaked, all credentials are decryptable.
# （用途：加密 CD 保存的 SSH 口令/私钥；泄露即全部凭据可解密。）
# Required only when the devops-cd service is enabled in docker-compose.yml (joint deployment):
# （仅在 docker-compose.yml 中启用 devops-cd 服务（联合部署）时必填：）
#   - Empty value is rejected at startup by compose ${SECRET_KEY:?};
#     （留空时启用 devops-cd 会被 compose 的 ${SECRET_KEY:?} 直接拒绝启动；）
#   - Standalone CD deployment (Devops_CD repo) may leave it empty — CD auto-generates a .cd_secret_key file,
#     but container recreation loses that file (credentials must be re-entered);
#     explicit config still recommended in production.
#     （单独部署 CD（Devops_CD 仓库）时可留空，CD 会自动生成 .cd_secret_key 文件，
#      但容器重建会丢失该文件（需重新录入凭据），生产仍建议显式配置。）
SECRET_KEY=

# Token for CD to call the CI API (optional; empty disables CD build management)
# （CD 调用 CI API 的 token，可选，留空则 CD 的构建管理功能关闭）
CI_API_URL=http://glue.example.com
CI_API_TOKEN=dg_xxxxxxxxxxxxxxxxxx

# CD's read-only deploy-log endpoint (CI → CD; leave empty = deploy-log audit degrades to a placeholder)
# （CI 拉取 CD 部署日志的只读端点；留空则部署日志审计降级为占位提示）
#   - CD_BASE_URL: CD 服务基础地址。联合部署默认填容器名（devops-cd 容器内监听 8081）：
#       http://devops-cd:8081；裸机/CD 单独部署改成实际地址（如 https://cd.example.com）
#   - CD_API_TOKEN: CD 侧入站静态令牌（Authorization: Bearer），两端同值，openssl rand -hex 32 生成。
#       留空时 CD_BASE_URL 不生效（部署日志审计降级为占位提示）
CD_BASE_URL=http://devops-cd:8081
CD_API_TOKEN=

# Other CD options (usually no change needed, uncomment as required)（CD 其余可选项，一般不用改，按需取消注释）
# SSH_TIMEOUT=30
# CONTAINER_RESTART_POLICY=always
# FLUX_NAMESPACE=flux-system
# LOG_TRUNCATE_CHARS=2000
# NOTIFY_TRUNCATE_CHARS=200
# DINGTALK_SECRET=YOUR_DINGTALK_SECRET
# MONITORING_ENABLED=true
# MONITOR_CACHE_SERVERS=60
# MONITOR_CACHE_SYSTEM=30
# MONITOR_CACHE_NODES=30
# MONITOR_CACHE_PODS=30
# MONITOR_CACHE_DOCKER=30
# MONITOR_CACHE_POD_DETAIL=15
# ALERT_CHECK_INTERVAL=60
