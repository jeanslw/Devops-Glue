# ============================================================
# Docker Compose 共享变量（集中部署 CI + CD + MySQL 的唯一来源）
# ============================================================
# 本文件三处消费：
#   1. Compose 解析期插值：mysql 服务的 DB_PASS / DB_NAME
#   2. CI 容器 env_file：覆盖 config/app.env 里的同名 DB 键
#   3. CD 容器 env_file：提供 DB / Harbor / SECRET_KEY / CI_API_TOKEN
# 仅 Docker 下生效；CI 应用专属配置（LDAP / APP_ENV 等）仍在 config/app.env，裸机部署也只改 config/app.env。

# 可信反向代理跳数：直连 0，一层 nginx/网关 1，多层按层数递增
TRUSTED_PROXY_HOPS=1

# 容器时区（IANA 名称，如 Asia/Shanghai、UTC）
#TZ=Asia/Shanghai

# ---------------- 数据库（mysql 容器，CI + CD 共用） ----------------
# 仅在 mysql-data 卷首次初始化时生效；留空则 compose 拒绝启动，存量卷需手工建号。
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=devops
DB_PASS=
DB_ROOT_PASS=

# Jenkins / Git 平台 / Harbor / OIDC 登录配置已迁入 DB（ci_platform_connections / ci_app_settings / ci_oauth_clients），
# 升级时手动跑一次 cli/migrate-platform-connections.php / cli/migrate-oidc.php（幂等，只补 DB 无行）。

# ---------------- CI tag 清理 / 回填定时任务（秒，supervisord 循环间隔） ----------------
# 默认清理 3600（1 小时）、回填 1800（30 分钟），取消注释覆盖。
#TAG_CLEANUP_INTERVAL=3600
#TAG_BACKFILL_INTERVAL=1800

# ---------------- CI 数据库备份 ----------------
# 每次产出两份独立文件：ci（CI 表）+ cd（CD 表），落在 /data/backups，各自滚动保留 10 份。
# 默认关闭；间隔秒数默认 86400（每天）。
#DB_BACKUP_ENABLED=0
#DB_BACKUP_INTERVAL=86400

# ---------------- CI 应用日志 ----------------
# 自动清理超过 N 天的旧日志，默认 30，0=永久保留，无需 logrotate。
#LOG_RETAIN_DAYS=30

# ---------------- OIDC 单点登录（CD 经 Glue 登录，联合部署必填） ----------------
# CD 已移除本地密码登录，唯一入口是 Glue OIDC。启用 devops-cd 时三项必填，缺一 CD 启动被预检中止。
# 三项由 CD 容器读取，必须与 Glue 侧 DB（ci_oauth_clients / ci_app_settings）对应值逐字符一致。
# OIDC_ISSUER：Glue 对外地址，须与 OIDC 发现文档（/.well-known/openid-configuration）里的 issuer 字段完全一致。
#   同机（Docker Desktop / WSL）填 http://localhost:8080，并给 devops-cd 加 extra_hosts: ["localhost:host-gateway"]；
#   经域名/反代时用外部可达 URL。
OIDC_ISSUER=
# CD_OIDC_SECRET：与 Glue 侧 DB ci_oauth_clients.cd.secret 一致（任意强随机串）。
CD_OIDC_SECRET=
# CD_OIDC_REDIRECT_URI：CD 回调地址，须为浏览器实际访问 CD 的地址（含 scheme/host/port/path）。
CD_OIDC_REDIRECT_URI=

# ---------------- CD 专用 ----------------
# 字段加密密钥（openssl rand -base64 32 生成）：加密 CD 保存的 SSH 口令/私钥，泄露即全部凭据可解密。
# 仅启用 devops-cd 时必填：留空会被 compose ${SECRET_KEY:?} 拒绝启动；单独部署 CD 可留空（自动生成，但重建丢失）。
SECRET_KEY=

# CD 调用 CI API 的 token（可选，留空关闭 CD 构建管理）
CI_API_URL=http://glue.example.com
CI_API_TOKEN=

# CI 拉取 CD 部署日志的只读端点（留空则部署日志审计降级为占位提示）
# CD_BASE_URL：联合部署填容器名 http://devops-cd:8081，裸机/CD 单独部署改实际地址。
# CD_API_TOKEN：与 CD 侧同值，openssl rand -hex 32 生成；留空时 CD_BASE_URL 不生效。
CD_BASE_URL=
CD_API_TOKEN=

# ── cd镜像仓库(必填)──
HARBOR_BASE_URL=http://hub.example.com
HARBOR_USER=
HARBOR_PASSWORD=

# CD 其余可选项（一般不用改，按需取消注释）
# SSH_TIMEOUT=30
# CONTAINER_RESTART_POLICY=always
# FLUX_NAMESPACE=flux-system
# LOG_TRUNCATE_CHARS=2000
# NOTIFY_TRUNCATE_CHARS=200
# DINGTALK_SECRET=YOUR_DINGTALK_SECRET
# MONITORING_ENABLED=true
# MONITOR_CACHE_SERVERS=60
# MONITOR_CACHE_SYSTEM=30
# MONITOR_CACHE_NODES=30
# MONITOR_CACHE_PODS=30
# MONITOR_CACHE_DOCKER=30
# MONITOR_CACHE_POD_DETAIL=15
# ALERT_CHECK_INTERVAL=60
