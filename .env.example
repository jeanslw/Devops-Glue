# ============================================================
# Docker Compose 共享变量
# ============================================================
# 本文件三处消费：
#   1. Compose 解析期插值：mysql 服务的 DB_PASS / DB_NAME
#   2. CI 容器 env_file：覆盖 config/app.env 里的同名 DB 键
#   3. CD 容器 env_file：提供 DB / Harbor / SECRET_KEY / CI_API_TOKEN

# 可信反向代理跳数：直连 0，一层 1，多层按层数递增
TRUSTED_PROXY_HOPS=1

# 时区
#TZ=Asia/Shanghai

# ---------------- 数据库（mysql 容器，CI + CD 共用） ----------------
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=devops
DB_PASS=
DB_ROOT_PASS=

# ---------------- CI tag 清理 / 回填定时任务（秒，supervisord 循环间隔） ----------------
# 默认清理 3600（1 小时）、回填 1800（30 分钟），取消注释覆盖。
#TAG_CLEANUP_INTERVAL=3600
#TAG_BACKFILL_INTERVAL=1800

# ---------------- CI 数据库备份 ----------------
# 每次产出两份独立文件：ci（CI 表）+ cd（CD 表），落在 /data/backups，各自滚动保留 10 份。
# 默认关闭；间隔秒数默认 86400（每天）。
#DB_BACKUP_ENABLED=0
#DB_BACKUP_INTERVAL=86400

# ---------------- CI 应用日志 ----------------
# 自动清理超过 N 天的旧日志，默认 30，0=永久保留，无需 logrotate。
#LOG_RETAIN_DAYS=30

# ---------------- OIDC 单点登录（CD 经 Glue 登录；推荐直接在 Glue 后台配置） ----------------
# ── OIDC / SSO（首选在 Glue 后台配置）────────────────────────────
# v2.10.0 起 issuer / id_token_ttl / 客户端白名单（含 cd 的 Secret、Redirect URI、
# 所属系统、启用开关）的唯一权威是 Glue 的 DB，请在「系统设置 → 平台管理 →
# OIDC / SSO 配置」页维护，不要长期写在这里：DB 有值时这些 env 键不会被使用。
# 下面的键只剩两个用途：① 全新库（ci_oauth_clients 还是空表）引导时自动播种；
# ② 从旧版本升级时 `docker compose exec web php cli/migrate-oidc.php` 的一次性迁移输入。
# 漏建 cd 客户端时，CD 点登录会 302 到 Glue 后收到 400「client_id 或 redirect_uri 不匹配」。
# OIDC_ISSUER：Glue 对外地址，须与 /.well-known/openid-configuration 的 issuer 完全一致。
OIDC_ISSUER=
# 以下两项还多一个消费者：联合部署时 CD 容器读它们作为自己的 client_secret / 回调地址
# （CD 侧没有别的来源），因此不要删除；Glue 运行期不读它们。
# CD_OIDC_SECRET：须与 Glue 后台 cd 客户端的 Secret 逐字节一致。
CD_OIDC_SECRET=
# CD_OIDC_REDIRECT_URI：须与 Glue 后台 cd 客户端的 Redirect URI 逐字符一致
#（scheme/host/端口/路径）；不一致时 authorize 阶段直接 400。
CD_OIDC_REDIRECT_URI=
# 注意：此处不设 CD_OIDC_SYSTEM —— cd 客户端的「所属系统」是 Glue 的 DB 项
# （后台该客户端的「所属系统」字段），CD 侧也从不读它；要改归属请在后台改（DB 优先）。

# ---------------- CD 专用 ----------------
# 字段加密密钥（openssl rand -base64 32 生成），仅启用 devops-cd 时必填
SECRET_KEY=

# CD 调用 CI API 的 token（可选）
CI_API_URL=http://nginx
CI_API_TOKEN=

# CI 拉取 CD 部署日志的只读端点
# CD_API_TOKEN：与 CD 侧同值，openssl rand -hex 32 生成；留空时 CD_BASE_URL 不生效。
CD_BASE_URL=http://devops-cd:8081
CD_API_TOKEN=

# ── CD镜像仓库(必填)──
REGISTRY_USER=
REGISTRY_PASSWORD=
REGISTRY_INSECURE_AUTO=false

# SSH_TIMEOUT=30
# CONTAINER_RESTART_POLICY=always
# FLUX_NAMESPACE=flux-system
# LOG_TRUNCATE_CHARS=2000
# NOTIFY_TRUNCATE_CHARS=200
# DINGTALK_SECRET=YOUR_DINGTALK_SECRET
# MONITORING_ENABLED=true
# MONITOR_CACHE_SERVERS=60
# MONITOR_CACHE_SYSTEM=30
# MONITOR_CACHE_NODES=30
# MONITOR_CACHE_PODS=30
# MONITOR_CACHE_DOCKER=30
# MONITOR_CACHE_POD_DETAIL=15
# ALERT_CHECK_INTERVAL=60
