<?xml version="1.0"?>
<ruleset name="Devops-Glue">
    <description>PSR-12 with the 120-character line-length rule relaxed (the codebase legitimately exceeds it in many places).</description>

    <!-- 仅检查 src，排除 vendor 与测试/公共资源 -->
    <file>src</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
