# ============================================================
# Devops-Glue Staging 环境覆盖层模板
#
# 生效条件：APP_ENV=staging 时，由 src/Support/EnvFileLoader.php 作为第 3 层加载。
#   优先级：app.env.local > 真实环境变量（Docker env_file / shell export）> 本文件 > app.env
# 使用方式：部署预发实例时把 APP_ENV 设为 staging 即可，本文件不需要改名或复制。
#
# 约定：这里只放「随环境变化」的键；口令 / Token / 私钥等机密写 config/app.env.local（gitignore 忽略）。
# 未在此列出的键沿用 config/app.env 的值。修改后重启服务生效。
#
# 注意：Jenkins / Git / Harbor / OIDC issuer 等已迁入 DB（后台「平台连接配置」「OIDC / SSO 配置」页维护），
#       此处不再读取 env——在本文件里配它们不会生效。
# ============================================================

# ============ 应用 ============
APP_DEBUG=true                                # 预发开启调试便于排障（生产应为 false）
# API_BASE_URL=https://staging.example.com:8080
# CORS_ORIGIN=https://staging.example.com
# SYSTEM_TYPE=ci                              # ci / cd / both
# TRUSTED_PROXY_HOPS=1                        # 直连 0；置于反代之后 1

# ============ 运行时目录 ============
# 建议与生产实例区分目录，避免日志 / 备份 / 缓存混写。
# LOG_PATH=/data/logs/ci-platform-staging/
# LOG_RETAIN_DAYS=14
# BACKUP_DIR=/data/backups-staging
# GITLAB_ID_CACHE=/data/cache/gitlab_id_cache_staging.php

# ============ 数据库 ============
# 预发建议指向独立的库；DB_PASS 属机密，推荐改放 app.env.local。
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=devops_glue_staging
# DB_USER=root
# DB_PASS=
# DB_PATH=config/data/data.db                 # 仅 DB_DRIVER=sqlite 时生效

# ============ 敏感字段加密 ============
# ci_platform_connections 与 ci_oauth_clients 的对称加密密钥（base64 32 字节）。
# 各环境应使用不同的值；泄露即全部凭据可解密，建议放 app.env.local。
# DATA_ENC_KEY=

# ============ CD 对接 ============
# CD_BASE_URL=http://devops-cd-staging:8081
# CD_API_TOKEN=                               # 机密建议改放 app.env.local

# ============ 种子超管 ============
# 仅目标库 ci_admin_users 为空时首次建号生效；之后走后台「修改密码」。
# ADMIN_USER=root
# ADMIN_PASSWORD=                             # 机密建议改放 app.env.local

# ============ 构建 ============
# BUILD_MODE=jenkins,gitlab_ci,gitea_ci
# CUSTOM_PUSH_LOG_ALLOWED_HOSTS=gitlab.example.com,ci.example.com
