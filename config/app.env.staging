# ============================================================
# Devops-Glue Staging 环境覆盖层模板
#
# 生效条件：APP_ENV=staging 时，由 src/Support/EnvFileLoader.php 作为第 3 层加载。
#   优先级：app.env.local > 真实环境变量（Docker env_file / shell export）> 本文件 > app.env
# ============================================================

# ============ 应用 ============
APP_DEBUG=true
# API_BASE_URL=https://staging.example.com:8080
# CORS_ORIGIN=https://staging.example.com
# VOLUME : ci / cd / both
# SYSTEM_TYPE=ci
# TRUSTED_PROXY_HOPS=1

# ============ 运行时目录 ============
# LOG_PATH=/data/logs/ci-platform-staging/
# LOG_RETAIN_DAYS=14
# BACKUP_DIR=/data/backups-staging
# GITLAB_ID_CACHE=/data/cache/gitlab_id_cache_staging.php

# ============ 数据库 ============
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=devops_glue_staging
# DB_USER=root
# DB_PASS=
# 当DB_DRIVER=sqlite时生效
# DB_PATH=config/data/data.db

# ============ 敏感字段加密 ============
# 对称加密密钥,生成：php -r "echo base64_encode(random_bytes(32));"
# DATA_ENC_KEY=

# ============ CD 对接 ============
# CD_BASE_URL=http://devops-cd-staging:8081
# CD_API_TOKEN=

# ============ 种子超管 ============
# 仅目标库 ci_admin_users 为空时首次建号生效；
# ADMIN_USER=root
# ADMIN_PASSWORD=

# ============ 构建 ============
# BUILD_MODE=jenkins,gitlab_ci,gitea_ci
# CUSTOM_PUSH_LOG_ALLOWED_HOSTS=gitlab.example.com,ci.example.com
