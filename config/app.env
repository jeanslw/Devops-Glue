# ============================================================================
# DevOps Glue —— config/app.env
# 分支：release/vhost-2.8.6（虚拟主机 / 共享主机发行版，随包发布，无需命令行安装）
# ----------------------------------------------------------------------------
# 本文件已按「虚拟主机：无 CLI、无 Docker、尽量零外部依赖」预设：
#   * 数据库默认 SQLite：首次访问自动建表，库文件落 <项目根>/config/data/data.db；
#     若主机提供 MySQL，改用下方注释里的 DB_DRIVER=mysql + DB_* 即可。
#   * 生产模式：APP_ENV=production、APP_DEBUG=false。
#   * 日志目录 / 对外地址留空走程序默认，如需固定请按注释填写主机绝对路径与真实域名。
# 本文件只含占位符、不含任何真实密钥。本地开发请在 config/app.env.local 填真实值
# （该文件已被 .gitignore 排除，绝不入库）；服务器上则直接改本文件后上传，务必改 ADMIN_PASSWORD。
# ============================================================================

# ==================== CI Jenkins ====================
JENKINS_BASE_URL=http://your_jenkins_address
JENKINS_USER=
JENKINS_TOKEN=

# ==================== Harbor ====================
HARBOR_BASE_URL=http://your_harbor_address
HARBOR_USER=
HARBOR_PASSWORD=

# ==================== Git 多平台 ====================
# 域名无法识别时使用的默认 Git 平台（可选 gitlab|gitee|github|gitea）
DEFAULT_GIT_PLATFORM=gitlab

# GitLab
GITLAB_BASE_URL=http://your_gitlab_address
GITLAB_TOKEN=

# Gitea（自建）
GITEA_BASE_URL=
GITEA_TOKEN=

# GitHub（公有云默认 https://api.github.com）
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=

# Gitee（公有云默认 https://gitee.com/api/v5）
GITEE_BASE_URL=https://gitee.com/api/v5
GITEE_TOKEN=

# ==================== 应用 ====================
APP_ENV=production
APP_DEBUG=false
BUILD_TIMEOUT=300

# 应用日志目录（Logger 按天滚动 app-YYYY-MM-DD.log）。必须是「主机上的绝对路径」。
# 不配置时回退默认 /data/logs/ci-platform/（虚拟主机上通常不可写 → 等于不写日志，不影响功能）。
# 建议填主机上可写目录，例如：LOG_PATH=/home/youruser/logs/devops-glue/
# LOG_PATH=

# 对外访问地址（仅用于 API 文档展示；留空 = 运行时按请求 Host 自动推导）
# API_BASE_URL=https://glue.example.com

# ==================== 数据库 ====================
# 默认 SQLite：无需外部服务，首次访问自动建表（DB_AUTO_MIGRATE=true）。
# 请确保 <项目根>/config/data/ 对 PHP 运行用户可写（Linux：chmod 755 config/data，勿用 777）。
DB_DRIVER=sqlite
DB_AUTO_MIGRATE=true

# ---- 若要改用 MySQL：把上面 DB_DRIVER 改成 mysql，并取消下列注释后填写 ----
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=devops_glue
# DB_USER=root
# DB_PASS=your_db_password

# SQLite 自定义库文件路径（仅 DB_DRIVER=sqlite 时生效，建议绝对路径）
# DB_PATH=/home/youruser/data/data.db

# 可信反向代理跳数（客户端 IP 识别 / 登录锁定）。
# 直连保持 0；多数虚拟主机前面还有一层 nginx/Apache 反代，此时设 1 才能取到真实客户端 IP。
# TRUSTED_PROXY_HOPS=1

# 实例类型：ci（默认）/ cd / both，影响登录权限校验
# SYSTEM_TYPE=ci

# 构建模式（仅首次运行的种子值，之后以数据库 ci_app_settings.build_mode 为准）
# 可选值（逗号分隔取子集）：jenkins,gitlab_ci,gitea_ci
BUILD_MODE=jenkins,gitlab_ci,gitea_ci

# ==================== 管理后台 ====================
# ⚠️ 首次启动以此创建超管账号，上传后请立即登录后台修改密码！
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# 超管邮箱（建议配置；留空则按部署环境生成 admin@<host>.local 占位地址）
# ADMIN_EMAIL=admin@example.com

# 找回密码恢复令牌（无 CLI 环境兜底）：
#   设置一个高熵随机串（如 `openssl rand -hex 32` 的输出），并把同一值离线保存。
#   忘记超管密码时，浏览器访问 /recover，凭此令牌即可重设超管密码。
#   留空 = 关闭找回密码通道（默认，最安全）。令牌放本文件或 config/app.env.local，
#   绝不写入任何 git 仓库。
# ADMIN_RECOVERY_TOKEN=

# ==================== OAuth / OIDC（SSO）====================
# Grafana Generic OAuth 客户端密钥（对应 settings.php oauth_clients.grafana）
# GRAFANA_OAUTH_SECRET=

# Glue 作为 OIDC Provider 的对外地址（issuer）。
# 留空 = 运行时按请求 Host 推导；生产建议显式填写下游系统可达的完整 URL（含 scheme、非默认端口）。
# OIDC_ISSUER=https://glue.example.com

# Jenkins oic-auth 客户端密钥（对应 settings.php oauth_clients.jenkins）
# JENKINS_OIDC_SECRET=

# ==================== LDAP 登录（可选）====================
# 需 PHP ext-ldap 扩展；虚拟主机通常无 LDAP 目录，默认关闭。
LDAP_ENABLED=false
# LDAP_HOST=127.0.0.1
# LDAP_PORT=389
# LDAP_USER_DN_PATTERN=uid=%s,ou=Users,dc=ldap,dc=example
# LDAP_NETWORK_TIMEOUT=5
