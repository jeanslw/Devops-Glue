#================== CI 部分配置 ============================
# Jenkins
JENKINS_BASE_URL=http://your-jenkins:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_token

# Harbor 镜像仓库
HARBOR_BASE_URL=http://your-harbor
HARBOR_USER=admin
HARBOR_PASSWORD=your_harbor_password

# ==================== Git 多平台配置 ======================
# GitLab（至少配一个 Git 平台）
GITLAB_BASE_URL=http://your-gitlab
GITLAB_TOKEN=your_gitlab_token

# GitHub（公有云默认 https://api.github.com）
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=

# Gitee（公有云默认 https://gitee.com/api/v5）
GITEE_BASE_URL=https://gitee.com/api/v5
GITEE_TOKEN=

# Gitea（私有部署）
GITEA_BASE_URL=https://your-gitea
GITEA_TOKEN=

# ======================= 系统配置 =========================
# 运行环境：production | staging | development
APP_ENV=production

# API 外部访问地址（Swagger UI / OpenAPI 文档用）
API_BASE_URL=http://127.0.0.1:8080

# CORS 允许的域名（默认 * 允许所有，多个逗号分隔）
# CORS_ORIGIN=https://your-frontend.com,https://another.com

# 调试模式：true 显示详细错误，false 只返回 500
APP_DEBUG=false

# Jenkins 构建超时（秒）
BUILD_TIMEOUT=300

# 数据库
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=root
DB_PASS=your_db_password

# SQLite 模式（DB_DRIVER=sqlite 时生效，默认 config/data/data.db）
# DB_PATH=config/data/data.db

# 当前实例类型：ci（默认）/ cd / both（影响登录权限校验）
# SYSTEM_TYPE=ci

# 自动建表（默认 true，应用启动时自动创建表）
# DB_AUTO_MIGRATE=true

# Build 模式：jenkins | gitlab_ci | both
BUILD_MODE=both

# 管理后台登录
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
