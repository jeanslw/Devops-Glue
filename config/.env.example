# ======================= CI Configuration ======================
# Jenkins
JENKINS_BASE_URL=http://your-jenkins:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_token

# Harbor image registry
# Robot account (robot$xxx) can only call the REST API on Harbor v2.2.0+ (secret-based).
# On v1.x / v2.0.x / v2.1.x the robot token is a JWT (Docker/Helm CLI only) — use a normal account.
# Docker 部署时 HARBOR_* 由仓库根目录 .env 注入覆盖；裸机才用这里的值。
HARBOR_BASE_URL=http://your-harbor
HARBOR_USER=admin
HARBOR_PASSWORD=your_harbor_password

# ==================== Git Multi-Platform ======================
# GitLab (at least one Git platform required)
GITLAB_BASE_URL=http://your-gitlab
GITLAB_TOKEN=your_gitlab_token

# GitHub (public cloud default: https://api.github.com)
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=

# Gitee (public cloud default: https://gitee.com/api/v5)
GITEE_BASE_URL=https://gitee.com/api/v5
GITEE_TOKEN=

# Gitea (self-hosted)
GITEA_BASE_URL=https://your-gitea
GITEA_TOKEN=

# ======================= System Configuration ==================
# Environment: production | staging | development
APP_ENV=production

# External API base URL (for Swagger UI / OpenAPI docs)
API_BASE_URL=http://127.0.0.1:8080

# CORS allowed origins (default * allows all, comma-separated)
# CORS_ORIGIN=https://your-frontend.com,https://another.com

# Debug mode: true shows detailed errors, false returns generic 500
APP_DEBUG=false

# Jenkins build timeout (seconds)
BUILD_TIMEOUT=300

# Database
DB_DRIVER=mysql
# 裸机部署用 127.0.0.1；Docker 部署由仓库根目录 .env 注入（DB_HOST=mysql）覆盖此处。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=root
DB_PASS=your_db_password

# SQLite mode (active when DB_DRIVER=sqlite, default: config/data/data.db)
# DB_PATH=config/data/data.db

# 运行时数据目录（Docker 下统一挂载 /data；裸机保留上方相对路径默认值）
# LOG_PATH=/data/logs/ci-platform/                 # 应用日志（Logger 按天滚动）
# DB_PATH=/data/db/data.db                         # SQLite（仅 DB_DRIVER=sqlite 时）
# BACKUP_DIR=/data/backups                         # 备份输出（bin/backup.php）
# GITLAB_ID_CACHE=/data/cache/gitlab_id_cache.php  # GitLab 项目 ID 解析缓存

# Instance type: ci (default) / cd / both (affects login permission check)
# SYSTEM_TYPE=ci

# Auto-create tables (default true, creates tables on app startup)
# DB_AUTO_MIGRATE=true

# Build mode: jenkins | gitlab_ci | both (controls built-in Jenkins / GitLab CI registration)
# Custom_Push is an independent toggle (custom_push_enabled), orthogonal to build_mode.
# Configure providers in config/settings.php under build.custom_providers,
# then enable in admin panel: configure model → choice「enbled Custom_Push」.
BUILD_MODE=both

# Admin panel credentials
ADMIN_USER=admin
ADMIN_PASSWORD=change_me

# ==================== LDAP Login (optional) ======================
# 需 PHP ext-ldap 扩展（php.ini 启用 extension=ldap）；未安装/未启用不影响本地账号登录。
# 登录顺序：本地 admin_users → LDAP → .env 兜底。
# LDAP 用户须先在 user_identities 表中绑定（provider_type='ldap', provider_uid=用户DN）
# 才能登录，角色/权限取自 admin_users，不会在 Glue 中自动建号。
# LDAP_ENABLED=false
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# 加密二选一：USE_TLS=连接后 STARTTLS（389）；USES_LDAPS=直接 ldaps://（通常 636）
# LDAP_USE_TLS=false
# LDAP_USES_LDAPS=false
# LDAP_BASE_DN=ou=users,dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(uid=%s)
# 直连模式（跳过管理员搜索，直接拼 DN 绑定；配了此项则上面 bind/base/filter 不需要）：
# LDAP_USER_DN_PATTERN=uid=%s,ou=users,dc=example,dc=com
# LDAP_NETWORK_TIMEOUT=5


# ==================== OIDC Provider (SSO for Jenkins / Harbor / GitLab) ======================
# Glue 作为 OIDC Provider 的对外地址（issuer）。留空则运行时从请求 host 推导。
# 生产环境强烈建议显式配置为对外可达的完整 URL（如 https://glue.example.com）。
OIDC_ISSUER=

# id_token 签名私钥（RS256，RSA >= 2048 位 PEM）。留空则自动生成并持久化到 OIDC_KEY_FILE。
# 可填多行 PEM（用 \n 转义）或由 k8s secret 注入；生产环境建议固定不变（保证 kid/JWKS 稳定）。
# OIDC_RSA_PRIVATE_KEY=

# 自动生成私钥时的持久化路径（默认 <项目根>/config/data/oidc_rsa.pem，落盘后 chmod 0600）。
# 若自定义必须用绝对路径：相对路径会随进程工作目录（CWD）漂移，可能误生成到 public/ 导致私钥泄露。
# OIDC_KEY_FILE=

# id_token 有效期（秒，默认 3600）
# OIDC_ID_TOKEN_TTL=3600

# ---- OAuth2 / OIDC 客户端密钥（每家系统在 oauth_clients 里注册一个客户端，各配独立随机密钥）----
# 各家回调地址见 config/settings.php 的 oauth_clients 注释；secret 留空则该客户端被 fail-closed 剔除。
# Grafana（Generic OAuth，纯 OAuth2）
# GRAFANA_OAUTH_SECRET=

# Jenkins（oic-auth 插件，OIDC）
# JENKINS_OIDC_SECRET=

# Harbor（原生 OIDC）
# HARBOR_OIDC_SECRET=

# GitLab（OmniAuth openid_connect，OIDC）
# GITLAB_OIDC_SECRET=
