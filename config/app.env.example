# ============================================================
# Devops-Glue 环境变量模板
# 复制为 config/app.env 后填入真实值。
# 加载优先级：app.env.local > 真实环境变量 > app.env.{APP_ENV} > app.env
# 修改后重启服务生效。
# ============================================================

# ============ CI 系统 ============
# Jenkins / Git / Harbor / OIDC 登录配置已迁入 DB（ci_platform_connections / ci_app_settings / ci_oauth_clients），
# 此处不再读取 env。用后台「平台连接配置」「OIDC / SSO 配置」页维护，或跑
# cli/migrate-platform-connections.php / cli/migrate-oidc.php 一次性迁移旧 env 值。

# 构建模式（首次运行种子，后台「配置模式」写入 DB 后以 DB 为准）
BUILD_MODE=jenkins,gitlab_ci,gitea_ci

# Custom_Push 拉取 log_url 的 SSRF 白名单（逗号分隔主机名，留空=仅拦截内网 IP 段）
# CUSTOM_PUSH_LOG_ALLOWED_HOSTS=gitlab.example.com,ci.example.com

# ============ Git 多平台 ============
# 仓库 URL 无法自动识别平台时的回退平台：gitlab|gitee|github|gitea
# DEFAULT_GIT_PLATFORM=gitlab

# ============ Harbor 镜像仓库 ============
# Harbor 连接已迁入 DB（ci_platform_connections），此处不再读取。

# ============ 管理后台 ============
# 种子超管账号（仅首次建库、表空时生效；之后改密走后台「修改密码」或离线 CLI）
ADMIN_USER=root
ADMIN_PASSWORD=change_me

# 新密码哈希算法：bcrypt | argon2id（切换只影响新写入，存量哈希照常校验）
# PASSWORD_HASH_ALGO=bcrypt

# /docs 旧版 base64 令牌兼容开关（默认关）
# ADMIN_LEGACY_TOKEN=false

# 种子超管邮箱（启用 SSO 建议配真实邮箱，否则 email_verified=false 下游可能拒绝登录）
# ADMIN_EMAIL=admin@example.com

# ============ LDAP（可选） ============
# 需 PHP ext-ldap；未启用不影响本地账号登录。登录顺序：本地 → LDAP → .env 兜底（仅首次启动）。
# LDAP 用户须先在 user_identities 绑定（provider_type='ldap', provider_uid=用户 DN）才能登录，不自动建号。
# LDAP_ENABLED=false
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# LDAP_USE_TLS=false
# LDAP_USES_LDAPS=false
# LDAP_BASE_DN=ou=users,dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(uid=%s)
# LDAP_ATTRS=uid,cn,mail,dn
# LDAP_USER_DN_PATTERN=uid=%s,ou=users,dc=example,dc=com
# LDAP_NETWORK_TIMEOUT=5
# LDAPTLS_CACERT=/path/to/ca.pem
# LDAPTLS_REQCERT=never

# ============ OIDC / SSO ============
# issuer / id_token_ttl / 客户端白名单已迁入 DB（ci_app_settings / ci_oauth_clients），后台「OIDC / SSO 配置」页维护。
# 生产务必把 issuer 配成对外可达的完整 URL：反代后自动推导会得到内网地址，导致 iss/jwks_uri 校验失败。

# id_token 签名私钥（RS256，RSA>=2048 PEM）。留空=自动生成并持久化到 OIDC_KEY_FILE；多副本部署必须固定同一把密钥。
OIDC_RSA_PRIVATE_KEY=

# 私钥自动生成时的持久化路径（落盘 chmod 0600，须绝对路径）。裸机默认 config/data/oidc_rsa.pem，Docker 为 /data/cache/oidc_rsa.pem。
# OIDC_KEY_FILE=/data/cache/oidc_rsa.pem

# CI 拉取 CD 部署日志的只读端点（留空=部署日志页降级为占位提示）
CD_BASE_URL=http://devops-cd:8081
CD_API_TOKEN=

# ============ 敏感字段加密 ============
# ci_platform_connections（token/username/password）与 ci_oauth_clients（secret）的对称加密密钥。
# base64 编码的 32 字节，生成：php -r "echo base64_encode(random_bytes(32));"
# 缺失即报错（fail-closed）：Docker env-check 直接拒绝启动、bootstrap 遇库内密文无 key 抛错拒服；
# 泄露即全部凭据可解密。多副本部署必须配置同一值，丢失则存量密文永久不可解。
DATA_ENC_KEY=

# ============ 数据库 ============
# sqlite 用 DB_PATH，Docker 下由仓库根 .env 注入覆盖（DB_HOST=mysql）。
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=root
DB_PASS=your_db_password
DB_PATH=config/data/data.db

# 自动建表（默认 true）；false 时先跑 database/mysql_init.sql 或 php cli/migrate.php
# DB_AUTO_MIGRATE=true

# 运行时目录（Docker 挂 /data，裸机用相对路径默认值）
# LOG_PATH=/data/logs/ci-platform/
# LOG_RETAIN_DAYS=30
# BACKUP_DIR=/data/backups
# DB_BACKUP_ENABLED=0
# DB_BACKUP_INTERVAL=86400
# GITLAB_ID_CACHE=/data/cache/gitlab_id_cache.php

# ============ 应用 ============
APP_ENV=production
APP_DEBUG=false

# 外部 API 地址（Swagger 文档地址）
API_BASE_URL=http://127.0.0.1:8080

# CORS 允许来源（默认 *，逗号分隔）
# CORS_ORIGIN=https://your-frontend.com

# 实例类型：ci | cd | both（影响登录权限校验）
# SYSTEM_TYPE=ci

# 可信反向代理跳数（直连 0；nginx 反代 1；用于识别客户端 IP / 登录锁定）
# TRUSTED_PROXY_HOPS=1
