# ============================================================
# Devops-Glue 环境变量模板
# 复制为 config/app.env 后填入真实值
# 加载优先级：app.env.local > 真实环境变量 > app.env.{APP_ENV} > app.env
# ============================================================

# 构建模式（首次运行）
BUILD_MODE=jenkins,gitlab_ci,gitea_ci

# Custom_Push log_url 的 SSRF 白名单
# CUSTOM_PUSH_LOG_ALLOWED_HOSTS=gitlab.example.com,ci.example.com


# ============ 管理后台 ============
# 种子超管账号
ADMIN_USER=root
ADMIN_PASSWORD=change_me

# 新密码哈希算法：bcrypt | argon2id
# PASSWORD_HASH_ALGO=bcrypt

#令牌兼容开关（默认关）
# ADMIN_LEGACY_TOKEN=false

# 种子超管邮箱
# ADMIN_EMAIL=admin@example.com

# ============ LDAP（可选） ============
# LDAP_ENABLED=false
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# LDAP_USE_TLS=false
# LDAP_USES_LDAPS=false
# LDAP_BASE_DN=ou=users,dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(uid=%s)
# LDAP_ATTRS=uid,cn,mail,dn
# LDAP_USER_DN_PATTERN=uid=%s,ou=users,dc=example,dc=com
# LDAP_NETWORK_TIMEOUT=5
# LDAPTLS_CACERT=/path/to/ca.pem
# LDAPTLS_REQCERT=never

# id_token 签名私钥（RS256，RSA>=2048 PEM）,多副本部署必须固定同一把密钥。
OIDC_RSA_PRIVATE_KEY=

# 私钥自动生成时的持久化路径
# OIDC_KEY_FILE=/data/cache/oidc_rsa.pem

# ============ 敏感字段加密 ============
# 对称加密密钥,生成：php -r "echo base64_encode(random_bytes(32));"
DATA_ENC_KEY=

# ============ 数据库 ============
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=root
DB_PASS=
#当DB_DRIVER=sqlite时生效
#DB_PATH=config/data/data.db

# 自动建表（默认 true）；false 时先跑 database/mysql_init.sql 或 php cli/migrate.php
# DB_AUTO_MIGRATE=true

# 运行时目录
# LOG_PATH=/data/logs/ci-platform/
# LOG_RETAIN_DAYS=30
# BACKUP_DIR=/data/backups
# DB_BACKUP_ENABLED=0
# DB_BACKUP_INTERVAL=86400
# GITLAB_ID_CACHE=/data/cache/gitlab_id_cache.php

# ============ 应用 ============
APP_ENV=production
APP_DEBUG=false

# 外部 API 地址（Swagger）
API_BASE_URL=http://127.0.0.1:8080

# CORS 允许来源（默认 *，逗号分隔）
# CORS_ORIGIN=https://your-frontend.com

# 实例类型：ci | cd | both
# SYSTEM_TYPE=ci

# 可信反向代理跳数（直连 0；nginx 反代 1）
# TRUSTED_PROXY_HOPS=1

# CI 拉取 CD 部署日志的只读端点
CD_BASE_URL=http://devops-cd:8081
CD_API_TOKEN=