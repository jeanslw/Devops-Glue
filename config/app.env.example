# =============================================================================
# Devops-Glue 环境变量模板 / Devops-Glue environment variable template
# =============================================================================
# 用法 / Usage:
#   将本文件复制为 config/app.env，填入真实凭据。
#   Copy this file to config/app.env and fill in real credentials.
#
# 加载优先级 / Loading priority（src/Support/EnvFileLoader.php）:
#   app.env.local > 真实环境变量（Docker env_file / shell export / 面板变量）
#   > app.env.{APP_ENV} > app.env；app.env.local 存在时，其中定义的键即为最终值。
#   app.env.local > real environment variables (Docker env_file / shell export)
#   > app.env.{APP_ENV} > app.env; when app.env.local exists its keys are final.
#
# 生效方式 / Applying changes:
#   环境变量在进程启动时加载，修改后需重启服务（Docker：docker compose restart）。
#   Variables are loaded at process start; restart the service after editing.
#
# CD 配对键 / CD-paired keys:
#   标注 [CD 配对] 的键必须与 Devops-Glue CD 侧配置逐字符一致，见第 7 节注释
#   与《管理员配置手册》附录 A（英文版 Admin Manual Appendix A）。
#   Keys marked [CD 配对] must match the Devops-Glue CD side character-for-character;
#   see section 7 and Admin Manual Appendix A.
# =============================================================================

# ============  CI 系统（CI Systems） ============

# Jenkins
JENKINS_BASE_URL=http://your-jenkins-address
JENKINS_USER=admin
JENKINS_TOKEN=your_jenkins_token

# Jenkins build timeout (seconds)（Jenkins 构建超时，秒）
BUILD_TIMEOUT=300

# Build mode: comma-separated set of enabled CI sources（构建模式：逗号分隔的已启用 CI 源集合）：
#   jenkins,gitlab_ci,gitea_ci = all three enabled（三项全启用）
#   jenkins,gitea_ci            = two enabled（只启用两项）
#   gitea_ci                    = single enabled（只启用一项）
#   (empty)                     = no pull CI, only Custom_Push（留空=无拉取式 CI，仅 Custom_Push）
# This is only a FIRST-RUN seed: the admin "Configure Mode" page writes the real value to the DB
# (ci_app_settings.build_mode), which is the single source of truth afterwards.
# Legacy `both` maps to `jenkins,gitlab_ci`.
# （这只是首次运行种子值：后台“配置模式”把真实值写入数据库 ci_app_settings.build_mode，
#   此后 DB 是唯一权威数据来源；旧值 `both` 读取时映射为 `jenkins,gitlab_ci`。）
# Custom_Push is an independent toggle (custom_push_enabled), orthogonal to build_mode.
# （Custom_Push 是独立开关（custom_push_enabled），与 build_mode 正交。）
# Configure providers in config/settings.php under build.custom_providers,
# then enable in admin panel: configure model, then choice "enable Custom_Push".
# （先在 config/settings.php 的 build.custom_providers 配置，再在后台“模型配置”页启用 Custom_Push。）
BUILD_MODE=jenkins,gitlab_ci,gitea_ci

# Custom_Push 服务端代理拉取 log_url 的 SSRF 白名单（可选，逗号分隔主机名）。
# 留空 = 不启用白名单，仅按回环 / 链路本地 / 组播 / 广播 / 云元数据 IP 段拦截。
# 建议内网部署显式配置，例如：
# CUSTOM_PUSH_LOG_ALLOWED_HOSTS=gitlab.example.com,ci.example.com

# ============  Git 多平台（Git Platforms） ============

# GitLab (at least one Git platform required)（GitLab，至少需要一个 Git 平台）
GITLAB_BASE_URL=http://your-gitlab-address
GITLAB_TOKEN=

# GitHub (public cloud default: https://api.github.com)（GitHub，公有云默认地址）
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=

# Gitee (public cloud default: https://gitee.com/api/v5)（Gitee，公有云默认地址）
GITEE_BASE_URL=https://gitee.com/api/v5
GITEE_TOKEN=

# Gitea (self-hosted)（Gitea，自建）
GITEA_BASE_URL=https://your-gitea-address
GITEA_TOKEN=

# Fallback platform when a repo URL cannot be auto-detected by keywords
# (e.g. self-hosted GitLab/Gitea domains often lack the platform keyword).
# Supported: gitlab | gitee | github | gitea. If the chosen platform is not
# registered (base_url/token unset), API calls for such repos will fail.
# （仓库 URL 按关键字无法自动识别平台时的回退平台；自建 GitLab/Gitea 域名通常不含
#   平台关键字，会降级到此项。可选 gitlab|gitee|github|gitea；若回退平台未注册
#   （未配 base_url/token），这些仓库的 API 调用会报"平台未配置或不可用"。）
# DEFAULT_GIT_PLATFORM=gitlab

# ============  Harbor 镜像仓库（Harbor Registry） ============

# Robot account (robot$xxx) can only call the REST API on Harbor v2.2.0+ (secret-based).
# On v1.x / v2.0.x / v2.1.x the robot token is a JWT (Docker/Helm CLI only) — use a normal account.
# （robot 机器人账号仅 Harbor v2.2.0+ 支持 REST API 调用（secret 鉴权）；
#   更早版本 token 是 JWT、仅用于 Docker/Helm CLI，请改用普通账号。）
# Bare-metal deployments use these values directly. In Docker mode HARBOR_* is
# injected/overridden by the repo-root .env.
# （仅裸机部署直接用这里的值；Docker 部署时 HARBOR_* 由仓库根目录 .env 注入覆盖。）
HARBOR_BASE_URL=http://your-harbor
HARBOR_USER=admin
HARBOR_PASSWORD=your_harbor_password

# ============  管理后台（Admin Panel） ============

# Admin panel credentials（管理后台账号；仅首次建库（表空时）生效，之后改密走离线 CLI 或后台「修改密码」）
ADMIN_USER=root
ADMIN_PASSWORD=change_me

# Password hash algorithm for NEW hashes: bcrypt (default) | argon2id（新写入密码的哈希算法：bcrypt（默认）| argon2id）
# password_verify() auto-detects the algorithm, so switching only affects new hashes;
# existing bcrypt hashes keep verifying with no migration.（password_verify 按前缀自动识别，
# 切换只影响新写入；存量 bcrypt 哈希照常校验，无需迁移。）
# argon2id is more GPU-resistant but allocates 64 MiB per verify — keep bcrypt unless the
# php-fpm memory budget is known to be sufficient.（argon2id 抗 GPU 更强，但每次校验分配 64 MiB，
# 确认 php-fpm 内存预算充足前建议保持 bcrypt。）
# PASSWORD_HASH_ALGO=bcrypt

# Legacy base64(user:password) token for /docs access（/docs 文档访问的旧版 base64 令牌兼容开关）
# Default off: that format never expires / cannot be revoked and equals a plaintext credential.
# The modern random token (sha256-stored) already covers docs access; enable only if an old
# Swagger client still needs the legacy token.（默认关：该格式无过期/无吊销、等价于明文凭证；
# 现代随机 token 已覆盖文档访问，仅当仍有旧 Swagger 客户端依赖旧令牌时才开启。）
# ADMIN_LEGACY_TOKEN=false

# ADMIN_EMAIL (optional) — email of the seeded super-admin account.（可选，种子超管账号的邮箱）
# Recommended when SSO (OAuth2 / OIDC) is enabled: without an email, userinfo and id_token can only return
# the placeholder admin@devops-glue.local and email_verified is honestly false; some downstream clients
# (auto-provision/match by email, e.g. Harbor, Jenkins, GitLab OmniAuth) require email_verified=true,
# otherwise login is rejected. Setting a real email avoids the issue.
# （建议启用单点登录（OAuth2 / OIDC）时配置：账号无邮箱时 userinfo 与 id_token 只能返回
#   admin@devops-glue.local 占位地址，且 email_verified 诚实报 false；部分按邮箱自动建号/匹配的
#   下游客户端（Harbor、Jenkins、GitLab OmniAuth）要求 email_verified=true，否则拒绝登录。
#   配置真实邮箱即可避开该问题。）
# Only written when the email is empty; never overwrites an email changed in the
# admin panel; invalid formats are ignored.
# （仅在 email 为空时写入，不覆盖后台手工改过的邮箱；格式非法则忽略。）
# ADMIN_EMAIL=admin@example.com

# ============  LDAP 外部身份源（可选 / LDAP external identity source, optional） ============

# Requires PHP ext-ldap (enable extension=ldap in php.ini); not installed/enabled
# does not affect local account login.
# （需 PHP ext-ldap 扩展（php.ini 启用 extension=ldap）；未安装/未启用不影响本地账号登录。）
# Login order: local admin_users, then LDAP, then .env fallback.（登录顺序：本地 admin_users、LDAP、.env 回退）
# LDAP users must first be bound in the user_identities table (provider_type='ldap', provider_uid=user DN)
# to log in; roles/permissions come from admin_users — accounts are NOT auto-provisioned in Glue.
# （LDAP 用户须先在 user_identities 表绑定（provider_type='ldap', provider_uid=用户DN）才能登录；
#   角色/权限取自 admin_users，不会在 Glue 中自动建号。）
# LDAP_ENABLED=false
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# Encryption, pick one: USE_TLS=STARTTLS after connect (389); USES_LDAPS=direct ldaps:// (usually 636).
# （加密二选一：USE_TLS=连接后 STARTTLS（389）；USES_LDAPS=直接 ldaps://（通常 636））
# LDAP_USE_TLS=false
# LDAP_USES_LDAPS=false
# LDAP_BASE_DN=ou=users,dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=
# LDAP_USER_FILTER=(uid=%s)
# Attributes read back after login (comma-separated); mail is used to refresh
# email — extend per directory schema (e.g. email/sAMAccountName).
# （登录成功后回读的属性（逗号分隔）；mail 用于回刷邮箱，可按目录 schema 增补（如 email/sAMAccountName））
# LDAP_ATTRS=uid,cn,mail,dn
# Direct-bind mode (skips admin search, binds with the assembled DN; when set,
# bind/base/filter above are not needed):
# （直连模式（跳过管理员搜索，直接拼 DN 绑定；配了此项则上面 bind/base/filter 不需要））
# LDAP_USER_DN_PATTERN=uid=%s,ou=users,dc=example,dc=com
# LDAP_NETWORK_TIMEOUT=5
# LDAPS with a self-signed cert: the OpenLDAP client reads these pass-through vars directly (not the app).
# For Docker, set them in config/.env — php-fpm runs with clear_env=no so they reach the client.
# （LDAPS 自签证书：OpenLDAP 客户端直接读这两个透传变量（非应用读取）。
#   Docker 下在 config/.env 设置即可，php-fpm 已配 clear_env=no 会透传给客户端）
# LDAPTLS_CACERT=/path/to/ca.pem
# LDAPTLS_REQCERT=never    # 仅内网自测跳过证书校验；生产环境禁止

# ============  OIDC Provider / 单点登录提供方（SSO issuer & signing） ============

# Public address (issuer) of Glue as an OIDC Provider. Empty = derived from the request host at runtime.
# （Glue 作为 OIDC Provider 的对外地址（issuer）。留空则运行时从请求 host 推导。）
# Production strongly recommends an explicit, externally reachable full URL (e.g. https://glue.example.com).
# （生产环境强烈建议显式配置为对外可达的完整 URL（如 https://glue.example.com）。）
# Behind a reverse proxy the derivation does NOT read X-Forwarded-Proto/Host, so it can yield an INTERNAL
# address (e.g. http://devops-glue): clients then fail `iss` verification, and
# discovery's `jwks_uri` also points inward — surfacing as a signature-verification failure rather
# than a network error. Set this explicitly.
# （反代之后不读 X-Forwarded-* 头，推导值可能是内网地址：客户端 iss 校验失败，且 discovery 的 jwks_uri
#   也指向内网，表现为验签失败而非网络不通，极易误判为密钥问题；经反代对外提供 SSO 必须显式配置。
#   联调前核对：curl -s <issuer>/.well-known/openid-configuration | jq .issuer,.jwks_uri 三者取值一致。）
# 联合部署（CD 经 Glue OIDC 登录）必填：CD 从该 issuer 自动发现端点并校验 id_token；留空会推导出内网地址导致登录失败。）
OIDC_ISSUER=

# id_token signing private key (RS256, RSA >= 2048-bit PEM). Empty = auto-generated
# and persisted to OIDC_KEY_FILE.
# Fill multi-line PEM (escaped with \n) or inject via k8s secret; keep it fixed in
# production (stable kid/JWKS).
# （id_token 签名私钥（RS256，RSA >= 2048 位 PEM）。留空则自动生成并持久化到 OIDC_KEY_FILE。
#   可填多行 PEM（用 \n 转义）或由 k8s secret 注入；生产环境建议固定不变（保证 kid/JWKS 稳定）。
#   联合部署且多副本时必须固定为同一把密钥，否则各副本 JWKS 不一致、id_token 验签失败。）
OIDC_RSA_PRIVATE_KEY=

# Persistence path when auto-generated (chmod 0600 after write). Absolute path
# required; relative paths drift with CWD.
# Bare-metal default <project-root>/config/data/oidc_rsa.pem; Docker image ENV is /data/cache/oidc_rsa.pem.
# （自动生成私钥时的持久化路径（落盘后 chmod 0600）。必须用绝对路径，相对路径会随 CWD 漂移。
#   裸机默认 <项目根>/config/data/oidc_rsa.pem；Docker 镜像 ENV 为 /data/cache/oidc_rsa.pem。）
# OIDC_KEY_FILE=/data/cache/oidc_rsa.pem

# id_token TTL in seconds (default 3600)（id_token 有效期，秒，默认 3600）
# OIDC_ID_TOKEN_TTL=3600

# ---- OAuth2 / OIDC 客户端密钥（client secrets）----
# One client per system in oauth_clients (config/settings.php), each with its own
# random secret. redirect_uri is injected via env and must match each callback
# character-for-character; a client with an empty secret or redirect_uri is removed
# (fail-closed).
# （每家系统在 oauth_clients（config/settings.php）里注册一个客户端，各配独立随机密钥。
#   redirect_uri 经 env 注入，与各家回调逐字符精确匹配；secret 或 redirect_uri 留空则该客户端被剔除。）

# Jenkins (oic-auth plugin, OIDC)（Jenkins，oic-auth 插件，OIDC）
# Jenkins local default http://localhost/... (no port — write the full URL per the actual listening port).
# （jenkins 本地默认 http://localhost/...（不含端口，按实际监听端口在环境变量里写全）。）
# Callback addresses: see the oauth_clients comments in config/settings.php.
# For production use the real callbacks; never commit intranet IPs.
# （各家回调地址见 config/settings.php 的 oauth_clients 注释；生产必须改成实际回调，不要把内网 IP 写进 git。）
# JENKINS_OIDC_SECRET=
# JENKINS_OIDC_REDIRECT_URI=http://localhost/securityRealm/finishLogin

# Harbor / GitLab OIDC clients are NOT registered by default: register them yourself in
# oauth_clients (see the commented examples in config/settings.example.php) and inject
# their secrets via env the same way.
# （Harbor / GitLab 的 OIDC 客户端默认不注册：在 oauth_clients 中参照 config/settings.example.php
#   的注释示例自行注册，secret 同样经 env 注入即可。）

# ============  Devops-Glue CD 对接（CI↔CD pairing / integration） ============
# 联合部署时哪些键 CI/CD 共用、哪些各自独立，以及裸机部署的最小配置，
# 见 docs/管理员配置手册.md 附录 A 末尾「联合部署」「裸机部署」两节。
# （For joint CI+CD deployments (shared vs. per-service keys) and the bare-metal
#   minimal checklist, see the end of Appendix A in docs/ADMIN_MANUAL.md.）

# ---- 1. CD 经 Glue OIDC 登录（BFF 机密客户端 / CD signs in via Glue OIDC）----
# The secret stays on CD's backend and the browser only holds CD's own cookie.
# （secret 只存在 CD 后端，浏览器只持有 CD 自己的 Cookie。）
#
# 配对规则（Pairing rules — 两边必须逐字符一致 / both sides must match character-for-character）:
#   client_id    = cd                 （固定：Glue oauth_clients 数组键，不可改 / fixed: the array key）
#   client_secret = <CD_OIDC_SECRET>  （= CD 后端 client_secret / must equal CD's backend secret）
#   redirect_uri = <CD_OIDC_REDIRECT_URI>（= CD 回调地址 / must equal CD's callback URL）
#   端点（issuer/authorize/token/userinfo）由 CD 从 Glue 的
#   /.well-known/openid-configuration 自动发现（OIDC_ISSUER，见第 6 节）。
#   （CD discovers the endpoints from Glue's /.well-known/openid-configuration — OIDC_ISSUER, section 6.）
#
# The secret has NO format requirement — any strong random string works (Glue only
# compares it byte-for-byte via hash_equals). Generate with:
# （secret 无格式要求，任意强随机串即可（Glue 只做 hash_equals 逐字节比较）。生成命令：）
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Distribute the same value to both sides via an ops channel; never commit it to git.
# （同一个值经运维渠道同步到两端，不要写进 git。）
# Either value empty = the client is dropped (fail-closed); redirect_uri must match
# CD's callback character-for-character.
# （两者留空则该客户端被剔除（fail-closed）；redirect_uri 必须与 CD 的回调地址逐字符一致。）
# Docker 联合部署：OIDC_ISSUER / CD_OIDC_SECRET / CD_OIDC_REDIRECT_URI 还需同时写入仓库根 .env
# （CD 容器经 env_file 读取），且 Docker 下根 .env 覆盖本文件同名键——联合部署以根 .env 为准，
# 本文件的这三项仅裸机生效。两边值必须逐字符一致。
# （Docker joint deployment: also put these three keys in the repo-root .env — the CD container reads
#   them via env_file, and in Docker the root .env overrides these keys, so it is canonical; these
#   values apply to bare-metal only. Both sides must match character-for-character.）
CD_OIDC_SECRET=
CD_OIDC_REDIRECT_URI=https://cd.example.com/oauth/callback
# Account-system ownership of this client: accounts signing in must own this
# system (default cd; unset/empty = back to ci).
# （该客户端登录账号的归属系统：登录账号必须拥有该系统（默认 cd；不设/留空 = 回退 ci）。）
# CD_OIDC_SYSTEM=cd

# ---- 2. CI 拉取 CD 部署日志（CI → CD, read-only）----
# Devops-CD deploy-log endpoint. Read-only; leave empty = the deploy-log audit page
# degrades to a placeholder (no 500).
# （CI 拉取 CD 部署日志的只读端点。留空 = 部署日志审计页降级为占位，不报 500。
#   Docker 联合部署默认填 CD 容器名：devops-cd 容器内监听 8081 → http://devops-cd:8081；
#   裸机/CD 单独部署改成实际地址。CD_API_TOKEN 与 CD 侧入站令牌两端同值。）
CD_BASE_URL=http://devops-cd:8081
CD_API_TOKEN=

# ============  数据库与运行时数据（Database & Runtime Data） ============

# Database（数据库）
# Bare-metal uses 127.0.0.1. In Docker mode these DB_* values are
# injected/overridden by the repo-root .env (DB_HOST=mysql).
# （裸机部署用 127.0.0.1；Docker 部署由仓库根目录 .env 注入（DB_HOST=mysql）覆盖此处。）
# NOTE: when DB_DRIVER=mysql, the backup enumerates ALL base tables (incl. the shared cd_* tables) via
# information_schema, which only shows tables the account has some privilege on. This account MUST hold
# database-level (or global) SELECT/ALL on DB_NAME — the Docker default 'devops' account already gets
# database-level ALL at first init; bare-metal users must grant it themselves
# (else cd_* tables are skipped without an error).
# （注：DB_DRIVER=mysql 时，备份经 information_schema 枚举全部基础表（含共享的 cd_* 表），该视图只显示账户有权限的表。
#  此账户必须对 DB_NAME 持有库级（或全局）SELECT/ALL——Docker 默认 devops 账号首启即被授予库级 ALL；裸机需自行授权，
#  否则 cd_* 表会被漏备且不报错。）
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=root
DB_PASS=your_db_password

# SQLite mode (active when DB_DRIVER=sqlite, default: config/data/data.db)
# （SQLite 模式，DB_DRIVER=sqlite 时生效，默认路径）
DB_PATH=config/data/data.db

# Runtime data directories (Docker mounts under /data; bare-metal keeps the
# relative-path defaults above)（运行时数据目录，Docker 下统一挂载 /data；裸机保留上方相对路径默认值）
# LOG_PATH=/data/logs/ci-platform/                 # App log, rotated daily by Logger（应用日志，Logger 按天滚动）
# LOG_RETAIN_DAYS=30                              # App log retention days; Logger deletes older app-*.log
#   (0=keep forever)（应用日志保留天数，0=永久保留）
# DB_PATH=/data/db/data.db                         # SQLite (only when
#   DB_DRIVER=sqlite)（仅 DB_DRIVER=sqlite 时生效）
# BACKUP_DIR=/data/backups                        # Backup output (bin/backup.php)（备份输出）
# DB_BACKUP_ENABLED=0                             # Docker: daily backup loop produces CI/CD split files
#   (cli/backup-db.php); 0=off（定时备份，CI/CD 分离，0=关）
# DB_BACKUP_INTERVAL=86400                        # Backup loop interval in seconds when
#   enabled（启用后的备份循环间隔秒数）
# GITLAB_ID_CACHE=/data/cache/gitlab_id_cache.php  # GitLab project-ID resolution cache（GitLab 项目 ID 解析缓存）

# Auto-create tables (default true, creates tables on app startup)（自动建表，默认 true，应用启动时创建）
# When false, run database/mysql_init.sql first; use `php cli/migrate.php` to
# create tables / add columns (`--dry-run` = read-only pre-check).
# （设为 false 时先执行 database/mysql_init.sql；补表 / 补列用
#   `php cli/migrate.php`，它无视本开关；`--dry-run` 只读预检。）
# DB_AUTO_MIGRATE=true

# ============ 应用（Application） ============

# Environment: production | staging | development（运行环境）
APP_ENV=production

# Debug mode: true shows detailed errors, false returns generic 500（调试模式：true 显示详细错误，false 返回通用 500）
APP_DEBUG=false

# External API base URL (for Swagger UI / OpenAPI docs)（外部 API 地址，供 Swagger UI / OpenAPI 文档使用）
API_BASE_URL=http://127.0.0.1:8080

# CORS allowed origins (default * allows all, comma-separated)（CORS 允许的来源，默认 * 全放行，多个用逗号分隔）
# CORS_ORIGIN=https://your-frontend.com,https://another.com

# Instance type: ci (default) / cd / both (affects login permission check)（实例类型，影响登录权限检查）
# SYSTEM_TYPE=ci

# Trusted reverse-proxy hops for client IP / login lockout (default 0).（可信反向代理跳数，用于客户端 IP 识别 / 登录锁定）
# Keep 0 when directly exposed; set 1 behind nginx (add one per extra proxy layer).
# （直连保持 0；nginx 反代后设 1，每多一层代理加 1。）
# When 0, X-Forwarded-For is fully ignored and cannot be spoofed to bypass lockout.
# （为 0 时完全忽略 X-Forwarded-For，无法伪造绕过锁定。）
# TRUSTED_PROXY_HOPS=1
